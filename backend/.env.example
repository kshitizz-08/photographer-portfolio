# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Provide your MongoDB Atlas or local connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/photography_portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/photography_portfolio

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# In production, set this to your deployed frontend URL only.
# Example: https://elenavasquez.com,https://www.elenavasquez.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per window (per IP).  Adjust for your traffic patterns.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter limit applied only to the /api/inquiries endpoint
INQUIRY_RATE_LIMIT_WINDOW_MS=3600000
INQUIRY_RATE_LIMIT_MAX=10

# ── Keep-Alive / Uptime Monitoring ──────────────────────────────────────────
# Optional: Set your deployed backend URL to enable self-pinging every 14m to prevent free tier sleep.
# For UptimeRobot, configure an HTTP(s) monitor pointing to: https://<your-backend>.onrender.com/health
# KEEP_ALIVE_URL=https://photographer-backend.onrender.com

